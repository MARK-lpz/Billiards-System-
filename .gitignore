# Pictures and videos uploaded for tournaments (api/event_media.php). Each
# computer and the hosting keep their own; the folder is made again on the
# first upload.
Media/

# The real Semaphore SMS key. Never commit it: this repo is public, and
# Semaphore bans an account whose key shows up in a public repo. See
# config/sms.local.example.php.
config/sms.local.php

# The real database login (host, name, user, password), on each computer and on
# the hosting. Never commit it: this repo is public. See
# config/database.local.example.php.
config/database.local.php

# Customers' GCash receipt screenshots (config/online_payments.php). Private:
# they show names and numbers, so they never leave the computer or hosting that
# took them.
Receipts/
